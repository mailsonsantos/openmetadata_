# =============================================================================
# OpenMetadata OSS Sandbox — Variáveis de Ambiente
# =============================================================================
# Copie este arquivo para criar os arquivos .env necessários:
#
#   cp .env.example docker/.env
#   cp .env.example docker/openmetadata/.env
#
# Os valores abaixo são os padrões para ambiente local de desenvolvimento.
# =============================================================================

# -----------------------------------------------------------------------------
# MinIO (Object Storage compatível com S3)
# Console: http://localhost:9001
# -----------------------------------------------------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# -----------------------------------------------------------------------------
# Hive Metastore — Backend PostgreSQL
# -----------------------------------------------------------------------------
HIVE_METASTORE_DB_HOST=hive-metastore-db
HIVE_METASTORE_DB_PORT=5432
HIVE_METASTORE_DB_NAME=metastore
HIVE_METASTORE_DB_USER=hive
HIVE_METASTORE_DB_PASSWORD=hive

# -----------------------------------------------------------------------------
# Credenciais S3/MinIO — usadas pelo Spark e pelo Hive Metastore
# -----------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
S3_ENDPOINT=http://minio:9000

# -----------------------------------------------------------------------------
# Spark — geração de dados sintéticos
# NUM_ROWS: quantidade de linhas a gerar na tabela financial_transactions
# -----------------------------------------------------------------------------
NUM_ROWS=1000

# -----------------------------------------------------------------------------
# Portas dos serviços (devem coincidir com o docker-compose.yml)
# -----------------------------------------------------------------------------
TRINO_PORT=8080
OPENMETADATA_PORT=8585
