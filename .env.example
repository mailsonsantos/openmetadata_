# =============================================================================
# OpenMetadata OSS Sandbox — Variáveis de Ambiente
# =============================================================================
# Copie este arquivo para criar os arquivos .env necessários:
#
#   cp .env.example docker/.env
#   cp .env.example docker/openmetadata/.env
#
# Os valores abaixo são os padrões para ambiente local de desenvolvimento.
# =============================================================================

# -----------------------------------------------------------------------------
# MinIO (Object Storage compatível com S3)
# Console: http://localhost:9001
# -----------------------------------------------------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# -----------------------------------------------------------------------------
# Hive Metastore — Backend PostgreSQL
# -----------------------------------------------------------------------------
HIVE_METASTORE_DB_HOST=hive-metastore-db
HIVE_METASTORE_DB_PORT=5432
HIVE_METASTORE_DB_NAME=metastore
HIVE_METASTORE_DB_USER=hive
HIVE_METASTORE_DB_PASSWORD=hive

# -----------------------------------------------------------------------------
# Credenciais S3/MinIO — usadas pelo Spark e pelo Hive Metastore
# -----------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
S3_ENDPOINT=http://minio:9000

# -----------------------------------------------------------------------------
# Spark — geração de dados sintéticos
# NUM_ROWS: quantidade de linhas a gerar na tabela financial_transactions
# -----------------------------------------------------------------------------
NUM_ROWS=1000

# -----------------------------------------------------------------------------
# Portas dos serviços (devem coincidir com o docker-compose.yml)
# -----------------------------------------------------------------------------
TRINO_PORT=8080
OPENMETADATA_PORT=8585

# -----------------------------------------------------------------------------
# OpenMetadata Database — credenciais (centralizadas aqui)
# -----------------------------------------------------------------------------
OM_DB_HOST=openmetadata-db
OM_DB_PORT=5432
OM_DB_NAME=openmetadata_db
OM_DB_USER=openmetadata_user
OM_DB_PASSWORD=openmetadata_password

# -----------------------------------------------------------------------------
# Limites de Recursos — valores calibrados para host com 10 GB de RAM
# Total sem Spark: ~6.5 GB | Total com Spark: ~8.5 GB
# Docker Desktop (Windows): alocar ao menos 8 GB em Settings > Resources
# Linux nativo: sem configuração adicional necessária
# -----------------------------------------------------------------------------
MEM_MINIO=512m
MEM_HIVE_METASTORE_DB=256m
MEM_HIVE_METASTORE=1g
MEM_TRINO=2g
MEM_OM_DB=256m
MEM_ELASTICSEARCH=1g
MEM_OM_SERVER=1500m
MEM_MINIO_SETUP=64m
MEM_SPARK=2g

CPUS_MINIO=1.0
CPUS_HIVE_METASTORE_DB=0.5
CPUS_HIVE_METASTORE=1.0
CPUS_TRINO=2.0
CPUS_OM_DB=0.5
CPUS_ELASTICSEARCH=1.0
CPUS_OM_SERVER=2.0
CPUS_MINIO_SETUP=0.25
CPUS_SPARK=4.0

# Heaps JVM — deve ser menor que o MEM_ correspondente
# Elasticsearch usa MEM_ELASTICSEARCH para o container e ES_HEAP_SIZE para a JVM
ES_HEAP_SIZE=512m
TRINO_HEAP_SIZE=1g
OM_HEAP_SIZE=1g
HIVE_METASTORE_HEAP_SIZE=512m
